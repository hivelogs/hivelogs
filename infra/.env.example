# HiveLogs - Variáveis de ambiente (desenvolvimento local)
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# TimescaleDB
# -----------------------------------------------------------------------------
TIMESCALEDB_USER=hivelogs
TIMESCALEDB_PASSWORD=change-me
TIMESCALEDB_DB=hivelogs
TIMESCALEDB_PORT=5432

# -----------------------------------------------------------------------------
# API (apps/api) — placeholder
# -----------------------------------------------------------------------------
API_PORT=8080
API_ASPNETCORE_ENVIRONMENT=Development
API_CONNECTION_STRING=Host=timescaledb;Port=5432;Database=hivelogs;Username=hivelogs;Password=change-me
API_JWT_SECRET=change-me-use-a-long-random-secret

# -----------------------------------------------------------------------------
# Web (apps/web) — placeholder
# -----------------------------------------------------------------------------
WEB_PORT=5173
WEB_VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Worker (apps/worker) — placeholder
# -----------------------------------------------------------------------------
WORKER_DOTNET_ENVIRONMENT=Development
WORKER_CONNECTION_STRING=Host=timescaledb;Port=5432;Database=hivelogs;Username=hivelogs;Password=change-me

# -----------------------------------------------------------------------------
# MCP (apps/mcp) — placeholder
# -----------------------------------------------------------------------------
MCP_PORT=3001
MCP_API_URL=http://api:8080
MCP_ACCESS_TOKEN=change-me
